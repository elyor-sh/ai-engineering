# Шаблон переменных окружения.
# Скопируй в .env (`cp .env.example .env`) и заполни значения.
# .env в git НЕ попадает (см. .gitignore), этот файл — попадает. Ключи сюда не пиши!

# === Облачные провайдеры (для курса достаточно одного, рекомендуем OpenRouter) ===
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Локальные модели (Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
